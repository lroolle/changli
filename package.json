{
  "name": "changli",
  "version": "1.0.0",
  "description": "A continuous Chinese calendar: months, weeks and days in one uninterrupted run, with statutory holidays, lunar dates and solar terms.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "python3 -m http.server 8811",
    "test": "node test/verify.js && node test/verify-rules.mjs",
    "test:astro": "node test/verify.js",
    "test:rules": "node test/verify-rules.mjs",
    "mcp": "node mcp/server.mjs",
    "data:holidays": "node test/gen-holidays.mjs",
    "data:jurisdictions": "node test/gen-jurisdictions.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lroolle/changli.git"
  },
  "homepage": "https://github.com/lroolle/changli",
  "bin": {
    "changli-mcp": "./mcp/server.mjs"
  },
  "keywords": [
    "calendar",
    "holidays",
    "lunar-calendar",
    "chinese-calendar",
    "schengen",
    "mcp",
    "agentic",
    "拼假",
    "农历",
    "调休"
  ]
}
